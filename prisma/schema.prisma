generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  date      DateTime
  startTime DateTime
  endTime   DateTime
  address   String

  personId Int?
  person   Person? @relation(fields: [personId], references: [id])
}

model Person {
  id Int @id @default(autoincrement())

  users    User[]
  telegram TelegramAccount?
}

model TelegramAccount {
  id       Int     @id @default(autoincrement())
  chatId   String? @unique
  username String?

  personId Int?    @unique
  person   Person? @relation(fields: [personId], references: [id])
}
