generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DaySchedule {
  id    Int               @id @default(autoincrement())
  date  DateTime
  users DayScheduleUser[]
}

model DayScheduleUser {
  userId        Int
  dayScheduleId Int
  user          User        @relation(fields: [userId], references: [id])
  daySchedule   DaySchedule @relation(fields: [dayScheduleId], references: [id])

  @@id([userId, dayScheduleId])
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  startTime DateTime
  endTime   DateTime
  address   String

  personId Int?
  person   Person? @relation(fields: [personId], references: [id])

  schedules DayScheduleUser[]
}

model Person {
  id Int @id @default(autoincrement())

  users    User[]
  telegram TelegramAccount?
}

model TelegramAccount {
  id       Int     @id @default(autoincrement())
  chatId   String? @unique
  username String?

  personId Int?    @unique
  person   Person? @relation(fields: [personId], references: [id])
}
