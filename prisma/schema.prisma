generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  startTime DateTime
  endTime   DateTime
  address   String
  telegram  String?

  schedules        DayScheduleUser[]
  telegramAccounts TelegramAccount[]
}

model DaySchedule {
  id    Int               @id @default(autoincrement())
  date  DateTime
  users DayScheduleUser[]
}

model DayScheduleUser {
  userId        Int
  dayScheduleId Int
  user          User        @relation(fields: [userId], references: [id])
  daySchedule   DaySchedule @relation(fields: [dayScheduleId], references: [id])

  @@id([userId, dayScheduleId])
}

model TelegramAccount {
  id       Int     @id @default(autoincrement())
  chatId   String  @unique
  username String?

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}
